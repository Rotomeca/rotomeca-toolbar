{
	"name": "rotomecatoolbar",
	"version": "3.5.0-rc2",
	"description": "Application toolbar pour avoir des sites en arrière plan",
	"main": "dist/main.js",
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"build": "node scripts/build.js",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.preload.json",
		"debug": "pnpm run build && node scripts/dev.js",
		"pre-release": "node scripts/pre-release.js",
		"lint": "eslint . --ext .js,.ts",
		"test": "pnpm run build && node --test \"tests/**/*.test.js\"",
		"smoke": "pnpm run build && node scripts/smoke.js",
		"smoke:packaged": "node scripts/smoke.js --packaged",
		"verify:package": "node scripts/verify-package.js",
		"start": "pnpm run build && electron-forge start",
		"package": "pnpm run build && electron-forge package",
		"make": "pnpm run build && electron-forge make",
		"publish": "pnpm run build && electron-forge publish"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Rotomeca/rotomeca-toolbar.git"
	},
	"author": "Rotomeca",
	"license": "EUPL-1.2",
	"devDependencies": {
		"@electron-forge/cli": "^8.0.1",
		"@electron-forge/maker-deb": "^8.0.1",
		"@electron-forge/maker-rpm": "^8.0.1",
		"@electron-forge/maker-squirrel": "^8.0.1",
		"@electron-forge/maker-zip": "^8.0.1",
		"@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
		"@electron-forge/plugin-fuses": "^8.0.1",
		"@electron/asar": "4.3.2",
		"@electron/fuses": "^2.1.3",
		"@types/node": "24.19.2",
		"@typescript-eslint/eslint-plugin": "8.72.2",
		"@typescript-eslint/parser": "8.72.2",
		"electron": "^42.11.18",
		"esbuild": "0.28.2",
		"eslint": "^8.52.0",
		"lodash": "^4.17.21",
		"prettier": "^3.10.1",
		"prettier-eslint": "^17.1.3",
		"typescript": "6.0.3"
	},
	"dependencies": {
		"@rotomeca/design-system": "^1.1.0",
		"electron-squirrel-startup": "^1.0.1",
		"koffi": "^3.3.8"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"electron",
			"electron-winstaller"
		]
	}
}
